{
  "name": "@pmwdigital/opening-hours",
  "version": "0.1.0",
  "description": "Weekly opening hours: HH:MM validation, closing after midnight, IANA time zones and reservation slots. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmwdigital/pmw-opening-hours.git"
  },
  "keywords": [
    "opening-hours",
    "business-hours",
    "reservation",
    "time-slots",
    "timezone",
    "iana",
    "intl"
  ]
}
